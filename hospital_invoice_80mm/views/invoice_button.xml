
<odoo>
    <record id="view_move_form_inherit_80mm_button" model="ir.ui.view">
        <field name="name">account.move.form.80mm.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_report_invoice_80mm)d"
                        string="Print 80mm Receipt"
                        type="action"
                        class="btn-primary"/>
              <button name="action_print_thermal"
                string="Direct Print"
                type="object"
                class="btn-primary"/>


            </xpath>
        </field>
    </record>
</odoo>
