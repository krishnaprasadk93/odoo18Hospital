<odoo>
  <record id="view_move_form_qz_escpos" model="ir.ui.view">
    <field name="name">account.move.form.qz.escpos</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_post']" position="after">
        <button name="action_qz_direct_print"
                string="Direct ESC/POS Print"
                type="object"
                class="btn-primary"
                invisible="move_type != 'out_invoice'"/>
      </xpath>
    </field>
  </record>
</odoo>
