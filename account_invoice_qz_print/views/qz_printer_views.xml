<!-- views/qz_printer_views.xml -->
<odoo>
  <record id="view_qz_printer_tree" model="ir.ui.view">
    <field name="name">qz.printer.tree</field>
    <field name="model">qz.printer</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="is_default"/>
        <field name="paper_width_mm"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_qz_printer_form" model="ir.ui.view">
    <field name="name">qz.printer.form</field>
    <field name="model">qz.printer</field>
    <field name="arch" type="xml">
      <form string="QZ Printer">
        <sheet>
          <group>
            <field name="name"/>
            <field name="is_default"/>
            <field name="paper_width_mm"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
<record id="action_qz_printer" model="ir.actions.act_window">
    <field name="name">QZ Printers</field>
    <field name="res_model">qz.printer</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_qz_root" name="QZ Printing" parent="account.menu_finance"/>
  <menuitem id="menu_qz_printer" name="Printers"
            parent="menu_qz_root" action="action_qz_printer"/>


</odoo>
