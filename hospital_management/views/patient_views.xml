<odoo>
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form class="o_hc_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>

                    <!-- Patient profile header -->
                    <div class="o_hc_head">
                        <div class="o_hc_avatar"><field name="initials" readonly="1"/></div>
                        <div class="o_hc_head_main">
                            <div class="o_hc_eyebrow"><field name="patient_seq" readonly="1" class="oe_inline"/></div>
                            <h1 class="o_hc_title"><field name="name" placeholder="Patient name"/></h1>
                            <div class="o_hc_chips" invisible="not profile_summary">
                                <span class="o_hc_chip"><field name="profile_summary" class="oe_inline"/></span>
                            </div>
                        </div>
                    </div>

                    <group class="o_hc_cols">
                        <group string="Personal">
                            <field name="age"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="marital_status"/>
                        </group>
                        <group string="Contact &amp; medical">
                            <field name="phone" widget="phone"/>
                            <label for="blood_group" string="Blood Group"/>
                            <div class="o_row">
                                <field name="blood_group" class="oe_inline"/>
                                <field name="rh_type" widget="radio" class="oe_inline" options="{'horizontal': true}"/>
                            </div>
                            <field name="doctor_id" string="Family Doctor"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Visits" name="visits">
                            <field name="visit_ids" readonly="1"
                                   context="{'form_view_ref': 'hospital_management.view_op_ticket_popup_form'}">
                                <list default_order="appointment_date desc">
                                    <field name="appointment_date" string="Date"/>
                                    <field name="visit_no"/>
                                    <field name="token_number" string="Token" optional="hide"/>
                                    <field name="doctor_id"/>
                                    <field name="reason" string="Diagnosis"
                                           groups="hospital_management.group_hospital_doctor"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'op'" decoration-warning="state == 'consulting'"
                                           decoration-primary="state == 'pharmacy'" decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Address &amp; ID" name="contact">
                            <group>
                                <group>
                                    <label for="street" string="Address"/>
                                    <div class="o_address_format">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                    </div>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="barcode"/>
                                    <field name="barcode_png" widget="image" nolabel="1" colspan="2"
                                           class="o_hc_barcode" invisible="not barcode_png"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Details" name="other">
                            <group>
                                <group string="Family &amp; insurance">
                                    <field name="insurance_id"/>
                                    <field name="house_level"/>
                                    <field name="work_home"/>
                                </group>
                                <group string="Socioeconomic">
                                    <field name="economic_level"/>
                                    <field name="education_level"/>
                                    <field name="occupation"/>
                                    <field name="income"/>
                                </group>
                                <group string="Lifestyle">
                                    <field name="exercise"/>
                                    <field name="diet"/>
                                    <field name="sleep_hrs"/>
                                    <field name="smoker"/>
                                    <field name="drinker"/>
                                    <field name="alcoholic"/>
                                </group>
                                <group string="Women's health" invisible="gender == 'male'">
                                    <field name="fertile"/>
                                    <field name="menarche_age"/>
                                    <field name="pause"/>
                                    <field name="mammography"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list class="o_hc_patient_list">
                <field name="patient_seq" class="fw-semibold"/>
                <field name="name"/>
                <field name="age" optional="show"/>
                <field name="gender"/>
                <field name="phone" required="1"/>
                <field name="blood_group"/>
                <field name="doctor_id" string="Family Doctor" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <!-- Quick Search Fields -->
                <field name="patient_seq"
                   string="Patient ID / Name / Phone / Mobile"
                   filter_domain="['|', '|', '|',
                                   ('patient_seq', 'ilike', self),
                                   ('name', 'ilike', self),
                                   ('phone', 'ilike', self),
                                   ('mobile', 'ilike', self)]"/>
                 <!-- Individual field searches (optional) -->
                <field name="patient_seq"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="mobile"/>
                <separator string="Activity"/>

                <!-- Visited Today -->
                <filter name="visited_today"
                        string="Visited Today"
                        domain="[('visit_ids.create_date','>=',context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                <!-- New Patients This Month -->
                <filter name="new_this_month"
                        string="New This Month"
                        domain="[('create_date','>=',(context_today().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <separator/>

                <!-- Gender -->
                <filter name="male" string="Male" domain="[('gender','=','male')]"/>
                <filter name="female" string="Female" domain="[('gender','=','female')]"/>

                <separator/>

                <!-- Medical -->
                <filter name="smoker" string="Smokers" domain="[('smoker','=',True)]"/>
                <filter name="drinker" string="Drinkers" domain="[('drinker','=',True)]"/>
                <filter name="alcoholic" string="Alcoholic" domain="[('alcoholic','=',True)]"/>

                <separator/>

                <!-- Socioeconomic -->
                <filter name="low_income" string="Lower Class" domain="[('economic_level','=','low')]"/>
                <filter name="middle_income" string="Middle Class" domain="[('economic_level','=','middle')]"/>
                <filter name="upper_income" string="Upper Class" domain="[('economic_level','=','upper')]"/>

                <separator/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_gender" string="Gender" context="{'group_by':'gender'}"/>
                    <filter name="group_blood" string="Blood Group" context="{'group_by':'blood_group'}"/>
                    <filter name="group_doctor" string="Family Doctor" context="{'group_by':'doctor_id'}"/>
                    <filter name="group_economic" string="Socioeconomic" context="{'group_by':'economic_level'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No patients yet</p>
            <p>Click <b>New</b> to register a patient. Only a name and phone number are needed to start.</p>
        </field>
    </record>
</odoo>
