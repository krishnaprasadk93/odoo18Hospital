<odoo>
    <record id="view_account_move_filter_inherit_doctor" model="ir.ui.view">
    <field name="name">account.move.search.doctor</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_move_filter"/>
    <field name="arch" type="xml">

        <xpath expr="//filter[@name='journal']" position="after">
            <filter name="group_by_doctor"
                    string="Doctor"
                    context="{'group_by': 'doctor_id'}"/>
        </xpath>

    </field>
</record>
</odoo>