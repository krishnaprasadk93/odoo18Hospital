<odoo>
    <!-- Clinic home: quick tiles with live counts, opened when the app is clicked -->
    <record id="action_clinic_home" model="ir.actions.client">
        <field name="name">Clinic</field>
        <field name="tag">hospital_clinic_home</field>
    </record>

    <menuitem id="menu_hospital_root" name="Clinic" action="action_clinic_home"/>

    <record id="action_reception_dashboard" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.op.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No appointments here</p>
            <p>Click <b>New</b> to register a visit: pick the patient and doctor, then collect the fee and generate a token.</p>
        </field>
    </record>
    <record id="action_consultation_payment_wizard" model="ir.actions.act_window">
        <field name="name">Process Payment</field>
        <field name="res_model">consultation.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
<!-- Action -->
<record id="action_hospital_settings" model="ir.actions.act_window">
    <field name="name">Clinic Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">inline</field>
    <field name="context">{'module': 'hospital_management'}</field>
</record>


    <menuitem id="menu_reception_root" name="Reception" parent="menu_hospital_root" sequence="10" groups="group_hospital_receptionist"/>
    <record id="action_reception_queue" model="ir.actions.act_window">
        <field name="name">Today's Queue</field>
        <field name="res_model">hospital.op.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits today yet</p>
            <p>Click <b>New</b> to register the first patient of the day. Their card moves across the board as they see the doctor and the pharmacy.</p>
        </field>
    </record>

    <menuitem id="menu_reception_queue" name="Today's Queue" parent="menu_reception_root" action="action_reception_queue" sequence="1"/>
    <menuitem id="menu_reception_appointments" name="Appointments" parent="menu_reception_root" action="action_reception_dashboard" sequence="5"/>
    <menuitem id="menu_reception_patients" name="Patients" parent="menu_reception_root" action="action_hospital_patient" sequence="10"/>

    <record id="action_doctor_dashboard" model="ir.actions.act_window">
        <field name="name">My Consultations</field>
        <field name="res_model">hospital.op.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consultations for you</p>
            <p>Patients appear here once reception generates a token for you.</p>
        </field>
    </record>

    <menuitem id="menu_doctor_root" name="Doctor" parent="menu_hospital_root" sequence="20" groups="group_hospital_doctor"/>
    <record id="action_doctor_queue" model="ir.actions.act_window">
        <field name="name">My Queue</field>
        <field name="res_model">hospital.op.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('doctor_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your queue is empty</p>
            <p>Patients appear here once reception generates a token for you.</p>
        </field>
    </record>

    <menuitem id="menu_doctor_queue" name="My Queue" parent="menu_doctor_root" action="action_doctor_queue" sequence="1"/>
    <menuitem id="menu_doctor_consultation" name="Consultations" parent="menu_doctor_root" action="action_doctor_dashboard" sequence="5"/>
    <menuitem id="menu_doctor_dose_presets" name="Dose Presets" parent="menu_doctor_root" action="action_hospital_dose_preset" sequence="90"/>

    <record id="action_pharmacy_dashboard" model="ir.actions.act_window">
        <field name="name">Pharmacy Queue</field>
        <field name="res_model">hospital.op.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_hospital_op_ticket_pharmacy_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_op_ticket_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_op_ticket_form')})]"/>
        <field name="domain">[('state', '=', 'pharmacy')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pharmacy queue is clear</p>
            <p>Prescriptions appear here as soon as a doctor completes a consultation.</p>
        </field>
    </record>

    <menuitem id="menu_pharmacy_root" name="Pharmacy" parent="menu_hospital_root" sequence="30" groups="group_hospital_pharmacist"/>
    <menuitem id="menu_pharmacy_queue" name="Pharmacy Queue" parent="menu_pharmacy_root" action="action_pharmacy_dashboard"/>
    <!--<menuitem id="menu_pharmacy_settings" name="Configuration" parent="menu_pharmacy_root" sequence="100"/>
    <menuitem id="menu_pharmacy_list" name="Pharmacies" parent="menu_pharmacy_settings" action="action_hospital_pharmacy"/>-->
     <menuitem id="menu_hospital_medicines"
              name="Pharmacy Stock"
              parent="menu_pharmacy_root"
              action="action_medicine_products"
              sequence="10"/>
      <menuitem id="menu_hospital_sales_order"
              name="OTC Sales"
              parent="menu_pharmacy_root"
              action="sale.action_orders"
              sequence="30"/>
    <menuitem id="menu_hospital_pharmacy_stock_notification"
              name="Low Stock Alerts"
              parent="menu_pharmacy_root"
              action="pharmacy_stock_notification.action_pharmacy_stock_notification"
              sequence="40"
              groups="pharmacy_stock_notification.group_pharmacy_user"/>
    <!--  <menuitem id="menu_hospital_procedures"
              name="Procedures"
              parent="menu_pharmacy_settings"
              action="action_procedure_products"
              sequence="20"/>
          <menuitem id="menu_medicine_brands" name="Brands" parent="menu_pharmacy_settings" action="action_medicine_brand"/> -->
    <!-- Menu -->
<menuitem id="menu_hospital_settings"
          name="Settings"
          parent="menu_pharmacy_root"
          action="action_hospital_settings"
          sequence="100"
          groups="base.group_system"/>
</odoo>
