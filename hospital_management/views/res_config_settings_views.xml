<odoo>

    <record id="view_hospital_res_config_settings" model="ir.ui.view">
        <field name="name">hospital.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app data-string="Clinic" string="Clinic" name="hospital_management">

                    <block title="Visits &amp; revisits" name="hospital_visits_block">
                        <setting id="hospital_revisit_limit" string="Free revisit window"
                                 help="Consultation is free if the patient comes back within these days.">
                            <div class="d-flex align-items-baseline gap-2">
                                <field name="revisit_limit_days" class="o_light_label" style="width: 6rem;"/>
                                <span>days</span>
                            </div>
                        </setting>
                        <setting id="hospital_revisit_check" string="Count revisits by"
                                 help="Hospital-wide: any earlier visit counts. Doctor-wise: only an earlier visit to the same doctor counts.">
                            <field name="revisit_check_type" widget="radio" class="o_light_label"/>
                        </setting>
                    </block>

                    <block title="Payments" name="hospital_payments_block">
                        <setting id="hospital_payment_journals" string="Payment journals"
                                 help="Journals used by the payment popups. A payment is created for each method whose amount is more than 0.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="hospital_cash_journal_id" string="Cash" class="col-lg-3 o_light_label"/>
                                    <field name="hospital_cash_journal_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="hospital_card_journal_id" string="Card" class="col-lg-3 o_light_label"/>
                                    <field name="hospital_card_journal_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="hospital_upi_journal_id" string="UPI" class="col-lg-3 o_light_label"/>
                                    <field name="hospital_upi_journal_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="hospital_require_amount_collected"
                                 help="When a payment includes cash, the cashier must enter the amount the patient handed over before the invoice can be processed.">
                            <field name="require_amount_collected_entry"/>
                        </setting>
                    </block>

                </app>
            </xpath>

        </field>
    </record>

</odoo>
