<odoo>

    <record id="view_hospital_res_config_settings" model="ir.ui.view">
        <field name="name">hospital.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <div class="app_settings_block"
                     data-string="Hospital"
                     string="Hospital"
                     name="hospital_settings">

                    <h2>Hospital Settings</h2>

                    <div class="row mt16 o_settings_container">

                        <!-- Revisit Days -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">

                                <label for="revisit_limit_days"/>
                                <div class="text-muted">
                                    Consultation is free if patient revisits within these days.
                                </div>

                                <field name="revisit_limit_days"/>

                            </div>
                        </div>

                        <!-- NEW: Revisit Check Type -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">

                                <label for="revisit_check_type"/>
                                <div class="text-muted">
                                    Choose whether revisit validity is based on hospital-wide visits or the same doctor.
                                </div>

                                <field name="revisit_check_type" widget="radio"/>

                            </div>
                        </div>

                        <!-- NEW: Require Amount Collected Entry -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="require_amount_collected_entry"/>
                            </div>
                            <div class="o_setting_right_pane">

                                <label for="require_amount_collected_entry"/>
                                <div class="text-muted">
                                    When enabled, the cashier must enter the Amount Given by
                                    Customer whenever the payment includes a Cash amount
                                    greater than zero, before the invoice/payment can be processed.
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>