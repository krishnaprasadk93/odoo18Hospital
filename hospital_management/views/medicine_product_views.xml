<odoo>
    <!-- =========================
    MEDICINE list VIEW
    ========================== -->
    <record id="view_product_medicine_list" model="ir.ui.view">
        <field name="name">product.product.medicine.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Medicines">
                <field name="name"/>
                <field name="medicine_type"/>
                <field name="list_price"/>
                <field name="qty_available"/>
            </list>
        </field>
    </record>
    <!-- =========================
         MEDICINE FORM VIEW
    ========================== -->
    <record id="view_product_medicine_form" model="ir.ui.view">
        <field name="name">product.product.medicine.form</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <form string="Medicine">
                <!-- Force behavior fields (hidden) -->
                <field name="is_medicine" invisible="1"/>
                <field name="sale_ok" invisible="1"/>
                <field name="purchase_ok" invisible="1"/>
                 <field name="is_storable" invisible="1"/>
                <field name="type" invisible="1"/>
                <field name="uom_id" invisible="1"/>
                <field name="uom_name" invisible="1"/>

                <sheet>
                    <!-- SMART BUTTONS AREA -->
                    <div class="oe_button_box" name="button_box">
                    <button name="action_open_medicine_purchase_wizard"
                            type="object"
                            string="Purchase"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"/>

                        <!-- On Hand Button -->
                        <button class="oe_stat_button"
                                name="action_open_quants"
                                icon="fa-cubes"
                                type="object"
                                invisible="type != 'product'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="qty_available" widget="statinfo" nolabel="1" class="mr4"/>
                                    <span invisible="not uom_id">
                                        <field name="uom_name"/>
                                    </span>
                                </span>
                                <span class="o_stat_text">On Hand</span>
                            </div>
                        </button>

                        <!-- In/Out (Moves) Button -->
                        <button class="oe_stat_button"
                                name="action_view_stock_move_lines"
                                type="object"
                                icon="fa-arrows-h">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    In: <field name="nbr_moves_in" />
                                </span>
                                <span class="o_stat_value">
                                    Out: <field name="nbr_moves_out" />
                                </span>
                            </div>
                        </button>

                    </div>

                    <!-- Product Name on Top -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <!-- TABS -->
                    <notebook>
                        <!-- ================= GENERAL TAB ================= -->
                        <page string="General Information">
                            <group>
                                <group>
                                    <field name="tracking" string="Track Inventory" invisible="1"/>
                                    <field name="medicine_type"/>
                                </group>
                                <group>
                                    <field name="list_price" string="Sales Price" help=""/>
                                    <field name="minimum_qty" string="Minimum Stock Quantity" help=""/>
                                    <field name="enable_low_stock_alert" string="Enable Low Stock Alert" help=""/>
                                    <field name="standard_price" string="Cost Price" invisible="1"/>
                                    <field name="categ_id" string="Category" invisible="1"/>
                                    <field name="default_code" string="Reference" invisible="1" />
                                    <field name="description" string="Note" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>



    <!-- =========================
         ACTION
    ========================== -->
    <record id="action_medicine_products" model="ir.actions.act_window">
    <field name="name">Medicines</field>
    <field name="res_model">product.product</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_product_medicine_list"/>
    <field name="domain">[('is_medicine','=',True)]</field>
    <field name="context">
        {
            'default_is_medicine': True,
            'default_sale_ok': True,
            'default_purchase_ok': True,
            'default_type': 'consu',
            'form_view_ref': 'hospital_management.view_product_medicine_form'
        }
    </field>
</record>

</odoo>
