<odoo>
    <record id="view_hospital_dose_preset_list" model="ir.ui.view">
        <field name="name">hospital.dose.preset.list</field>
        <field name="model">hospital.dose.preset</field>
        <field name="arch" type="xml">
            <list string="Dose Presets" editable="bottom">
                <field name="medicine_type"/>
                <field name="dose_step"/>
                <field name="quick_doses" placeholder="e.g. 0.3,0.6,0.9"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_dose_preset" model="ir.actions.act_window">
        <field name="name">Dose Presets</field>
        <field name="res_model">hospital.dose.preset</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No dose presets yet</p>
            <p>Set the +/- step and the one-tap quick doses for each medicine type
                (e.g. tablets ½ steps, syrup 0.3 ml). Doctors can always type any dose.</p>
        </field>
    </record>
</odoo>
