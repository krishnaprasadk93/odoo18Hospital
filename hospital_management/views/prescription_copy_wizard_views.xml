<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_prescription_copy_wizard_form" model="ir.ui.view">
        <field name="name">op.prescription.copy.wizard.form</field>
        <field name="model">op.prescription.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Prescription from Previous Visit">
                <field name="ticket_id" invisible="1"/>
                <field name="patient_id" invisible="1"/>
                <group>
                    <group>
                        <field name="visit_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="visit_date"/>
                        <field name="visit_doctor_id"/>
                    </group>
                    <group>
                        <field name="visit_diagnosis" invisible="not visit_diagnosis"/>
                        <field name="replace_existing"/>
                    </group>
                </group>
                <field name="prescription_ids" readonly="1">
                    <list>
                        <field name="medicine_id"/>
                        <field name="morning_dose" string="Morning"/>
                        <field name="afternoon_dose" string="Afternoon"/>
                        <field name="evening_dose" string="Evening"/>
                        <field name="duration_number" string="For"/>
                        <field name="duration_type" string="Period"/>
                        <field name="instruction" string="When"/>
                        <field name="quantity" string="Qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_copy" type="object" string="Copy Prescription"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
