<odoo>

    <record id="view_hospital_print_preview_res_config_settings" model="ir.ui.view">
        <field name="name">hospital.print.preview.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hospital_management.view_hospital_res_config_settings"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='hospital_payments_block']" position="after">
                <block title="Printing" name="hospital_printing_block">
                    <setting id="hospital_show_print_preview"
                             help="Thermal receipts (consultation, pharmacy, invoice) open a print preview with a Print button instead of printing directly to QZ Tray.">
                        <field name="show_print_preview"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
