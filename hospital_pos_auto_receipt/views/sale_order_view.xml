<odoo>
    <record id="sale_confirm_override" model="ir.ui.view">
    <field name="name">sale.confirm.override</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//button[@name='action_confirm']" position="replace">
            <button name="action_open_split_payment"
                    type="object"
                    string="Confirm and Pay"
                    class="btn-primary"
                    invisible="invoice_status == 'invoiced'"
                   />
        </xpath>

         <xpath expr="//button[@name='action_confirm']" position="attributes">
             <attribute name="name">action_confirm_check_batch</attribute>
         </xpath>

         <xpath expr="//button[@name='action_quotation_send']" position="replace"/>
    </field>

</record>

<record id="view_sale_order_form_inherit_print" model="ir.ui.view">
        <field name="name">sale.order.form.print.qz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_reprint_qz_receipt"
                        type="object"
                        string="Reprint Receipt"
                        class="btn-secondary"
                        icon="fa-print"
                        modifiers="{'invisible': [['invoice_ids', '=', False]]}"/>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="amount_collected" readonly="1" invisible="not amount_collected"/>
                <field name="balance_amount" readonly="1" invisible="not amount_collected"/>
            </xpath>

        </field>
    </record>
 <record id="view_order_form_inherit_custom_return" model="ir.ui.view">
        <field name="name">sale.order.form.custom.return</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_open_custom_return_wizard"
                        type="object"
                        string="Return Medicine"
                        class="btn-secondary"
                        invisible="state not in ('sale', 'done')"/>
            </header>
        </field>
    </record>


</odoo>
