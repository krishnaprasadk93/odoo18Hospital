<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hospital_doctor_dashboard" model="ir.actions.client">
        <field name="name">Clinic Dashboard</field>
        <field name="tag">hospital_doctor_dashboard</field>
    </record>

    <!-- All dashboards live under this menu and are for doctors only: the
         menus are restricted here and every data endpoint checks the group
         again server side. -->
    <menuitem id="menu_hospital_dashboards"
              name="Dashboards"
              parent="hospital_management.menu_hospital_root"
              groups="hospital_management.group_hospital_doctor"
              sequence="5"/>

    <menuitem id="menu_hospital_doctor_dashboard"
              name="Clinic"
              parent="menu_hospital_dashboards"
              action="action_hospital_doctor_dashboard"
              groups="hospital_management.group_hospital_doctor"
              sequence="1"/>
</odoo>
