<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hospital_inventory_dashboard" model="ir.actions.client">
        <field name="name">Inventory Dashboard</field>
        <field name="tag">hospital_inventory_dashboard</field>
    </record>

    <!-- Doctors only (see hospital_doctor_dashboard.menu_hospital_dashboards).
         The "-" entries remove the groups an earlier version granted, since an
         upgrade otherwise only adds groups to an existing menu. -->
    <menuitem id="menu_hospital_inventory_dashboard"
              name="Inventory"
              parent="hospital_doctor_dashboard.menu_hospital_dashboards"
              action="action_hospital_inventory_dashboard"
              groups="-hospital_management.group_hospital_pharmacist,-stock.group_stock_manager,hospital_management.group_hospital_doctor"
              sequence="2"/>
</odoo>
