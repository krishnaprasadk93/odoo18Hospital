<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action: Daily Stock Check -->
        <record id="ir_cron_check_low_stock_daily" model="ir.cron">
            <field name="name">Pharmacy: Daily Low Stock Check</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_all_stock_levels()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- REMOVED numbercall -->
            <!-- Use 'numbercall' only if you are on older Odoo versions.
                 In Odoo 18, -1 (infinite) is default if not specified or handled differently. -->
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0)"/>
        </record>

    </data>
</odoo>
